[Unit]
Description=Family Planner Calendar Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/family-planner
ExecStart=/home/pi/family-planner/venv/bin/python app/main.py \
    --config /boot/firmware/family-planner.config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
